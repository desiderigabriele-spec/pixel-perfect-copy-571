# ══════════════════════════════════════════════════════════════════════
# HACK_THE_TRADING — variabili d'ambiente
# Copia questo file in .env.local per sviluppo locale (mai committare .env.local)
# Per Netlify: impostale in Site settings → Environment variables
# ══════════════════════════════════════════════════════════════════════

# ── Supabase (Supabase Dashboard → Project Settings → API) ───────────

# URL del progetto Supabase (es. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable / anon key (Project API keys → anon public)
# Su Netlify: scope "Build & Deploy" + "Runtime"
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Variabili server-side (Netlify Functions runtime) ────────────────
# Devono avere lo stesso valore delle corrispondenti VITE_ ma senza prefisso
# per essere accessibili dal server SSR Nitro (process.env)
# Su Netlify: scope "Runtime" (non serve il scope "Build")
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVICE ROLE KEY — bypassa RLS, usata solo dalle server functions
# NON usare lato client. Trovala in: Supabase → Project Settings → API → service_role
# Su Netlify: imposta come variabile SEGRETA (Sensitive variable)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase Edge Function secrets ───────────────────────────────────
# Impostare in: Supabase Dashboard → Edge Functions → Manage secrets
# (NON vanno su Netlify — vivono nel runtime Supabase Deno)

# RESEND_API_KEY=re_...
# HTT_FROM_EMAIL=HACK_THE_TRADING <noreply@hackthetrading.com>
# HTT_APP_URL=https://tuosito.netlify.app
# CRON_SECRET=...   (opzionale, protegge l'endpoint settle-expired)
